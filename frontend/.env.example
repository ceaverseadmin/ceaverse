# Backend origin for deployed builds (no /api suffix).
# Leave blank in local development to use the Vite proxy.
VITE_API_URL=

# Django backend URL for password reset and other HTML pages.
# Set to https://ceaverse-backend.onrender.com in production.
# Leave blank in local development to use http://127.0.0.1:8000.
VITE_BACKEND_URL=
