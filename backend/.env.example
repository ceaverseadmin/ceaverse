# Django
DJANGO_SECRET_KEY=django-insecure-please-change-me
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=
# Database.
# Local development defaults to SQLite when DATABASE_URL is not set.
# To use Neon/Postgres, paste your connection string here, e.g.:
# DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary (media storage) — leave blank to use local filesystem for media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ea-csc-web-portal

# CSRF trusted origins (Django admin over https)
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# Email Configuration (Brevo for password reset)
# Leave blank to use console backend (development)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_verified_email@domain.com
EMAIL_HOST_PASSWORD=your_brevo_api_key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
